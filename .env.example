# One env file for both packages in this repo. Settings are read by
# src/agentsys/config.py and src/rag/config.py respectively; both ignore keys
# they don't recognise, so a single shared file is safe.

# --- shared ---
# Model strings are litellm "provider/model" format -- e.g. openai/gpt-4o-mini
# or anthropic/claude-sonnet-5. ANTHROPIC_API_KEY only needs to be set if you
# point a *_MODEL setting at an anthropic/... model; otherwise leave it blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=

# =====================================================================
# agentsys (agent orchestration)
# =====================================================================
# Defaults below are for LOCAL (non-Docker) runs. docker-compose.yml overrides
# these to the in-network service hostnames (postgres/redis/chroma) itself.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agentsys
# Also read by src/rag/config.py -- sessions are created by agentsys's Google
# sign-in and validated by rag/auth.py reading the same Redis instance, so
# both packages must point at the same one. One shared value here covers it.
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Comma-separated browser origins allowed to call the API with credentials.
# For deployment, include the Vercel frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The reviewer deliberately runs on a different model tier than the
# specialist/supervisor, so it doesn't share their blind spots.
REVIEWER_LLM_MODEL=openai/gpt-4o

# --- service-to-service auth (REQUIRED for the Knowledge tool) ---
# The agent's knowledge_search tool calls rag-api's /v1/ask from the worker
# process, where there is no browser session to present. That endpoint had no
# authentication at all while rag-api publishes a host port, so anyone who
# could reach it could query the whole corpus and spend LLM budget.
#
# Both services read this SAME variable and the values must match exactly.
# docker-compose passes it to every service via env_file, so setting it once
# here is enough.
#
# Leave it unset and the system FAILS CLOSED: rag-api rejects /v1/ask for
# anything without a valid browser session, and knowledge_search reports that
# it is unconfigured rather than silently degrading.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=

# --- db_query hardening (optional but recommended) ---
# Only these tables are readable by the db_query tool. Enforced by resolving
# the query's real relations through EXPLAIN, not by matching the SQL text.
DB_QUERY_ALLOWED_TABLES=sample_metric
# A separate DSN for a Postgres role with SELECT on the allowlisted tables and
# nothing else -- see scripts/create_readonly_role.sql. This is the only layer
# enforced by the database rather than by application code, so it is the one
# that still holds if the allowlist above is ever wrong. Unset = the allowlist
# is the sole boundary.
DB_QUERY_URL=

# --- LLM resilience (see src/agentsys/llm.py) ---
# Nothing bounded a single model call before these existed: a hung provider
# held a worker for the full 20-minute Celery limit.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=20.0
# Optional. Tried once after transient exhaustion on the primary model, never
# after a permanent error. Chat models only.
LLM_FALLBACK_MODEL=

# --- Google sign-in (required to use the dashboard at all) ---
# OAuth 2.0 "Web application" credentials from Google Cloud Console
# (APIs & Services > Credentials > Create credentials > OAuth client ID).
# This is now how users sign in, not just an optional Drive/Gmail connector
# -- the same consent grants both identity (who's logged in) and the agent's
# Drive/Gmail access in one flow (see integrations/google_oauth.py's
# login_or_connect). Leave both blank and nobody can sign in at all. Setup:
#   1. Create/select a project at console.cloud.google.com
#   2. Enable the "Google Drive API" and "Gmail API"
#   3. Configure the OAuth consent screen (External; add yourself as a test
#      user while it's unverified)
#   4. Create an OAuth client ID (type: Web application) and add this exact
#      URL under "Authorized redirect URIs":
#        http://localhost:8100/v1/auth/google/callback
#   5. Paste the client ID/secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on the OAuth client byte-for-byte.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8100/v1/auth/google/callback
# Where the browser is sent back to after signing in -- the dashboard origin.
WEB_APP_URL=http://localhost:3000
# True in any environment served over HTTPS (Railway, etc.) -- see
# config.py's session_cookie_secure docstring. Leave false for local http://.
#
# This one flag drives three things at once, all of which are meaningful
# only over HTTPS: the cookie's Secure attribute, the __Host- cookie name
# prefix, and whether the HSTS header is sent at all. Note that flipping it
# CHANGES THE COOKIE NAME (af_session -> __Host-af_session), so live
# sessions are invalidated once at rollout -- deliberate, see the
# session_cookie property's docstring for why accepting both names would
# reopen the attack the prefix exists to prevent.
#
# Also read by src/rag/config.py, which mirrors the same name resolution --
# the two must agree or every browser-facing rag endpoint 401s.
SESSION_COOKIE_SECURE=false
# HSTS lifetime, only sent when SESSION_COOKIE_SECURE is true. One year is
# the preload-list minimum and the de-facto standard.
HSTS_MAX_AGE_SECONDS=31536000
# Adds the `preload` directive, requesting that browsers hardcode this
# domain as HTTPS-only. Off by default: it is effectively irreversible
# (removal takes months to reach users) and binds every present and future
# subdomain. Turn on only for a domain whose HTTPS posture is settled.
HSTS_PRELOAD=false

MAX_SUBTASK_RETRIES=2
PLAN_CONFIDENCE_ESCALATION_THRESHOLD=3
REVIEW_ESCALATION_THRESHOLD=2
MAX_TASK_STEPS=12

# The front door (see agentsys/graph/nodes.py triage_node). One cheap call
# decides whether a turn needs planning + tools + review at all, so a
# greeting doesn't cost three model calls. Fails open to the full path, and
# the fast path can't use tools -- set false to restore always-full.
ENABLE_TRIAGE=true
TRIAGE_MODEL=openai/gpt-4o-mini
# --- Google Photos (optional, off) ---
# The picker tool (agentsys/tools/google_photos.py). Turning it on is NOT just
# a preference:
#   1. Enable "Photos Picker API" in Google Cloud Console, AND declare the
#      scope https://www.googleapis.com/auth/photospicker.mediaitems.readonly
#      under APIs & Services > OAuth consent screen > Data access. These are
#      two separate steps: an undeclared scope is dropped SILENTLY at consent
#      time, so the token comes back missing it with no error anywhere.
#   2. Every already-connected Google account must DISCONNECT AND RECONNECT --
#      Google records granted scopes, so an existing token does not carry the
#      new one and every call 403s until it is re-granted.
# What it does: shows the user a picker and works with what they choose.
# What it cannot do: search the library. Google removed that for all
# third-party apps on 2025-03-31; it is not a limitation of this code.
ENABLE_GOOGLE_PHOTOS=false

MAX_DELEGATION_DEPTH=1
MAX_SUBAGENT_STEPS=4

DOCKER_SANDBOX_IMAGE=python:3.11-slim
# Free portfolio hosts usually do not expose a Docker socket. Set false there
# so code_execution disappears from the registry instead of falling back to an
# unsafe local subprocess.
ENABLE_CODE_EXECUTION=true
WORKSPACE_DIR=./data/workspace

# --- tracing (optional) ---
# Leave empty and nothing happens: the OpenTelemetry SDK is never imported
# and export costs nothing. Set it to a collector's gRPC endpoint and every
# run also arrives as a span tree in Phoenix / Langfuse / Datadog / Jaeger,
# on top of the TraceSpan rows that are always written. See agentsys/otel.py.
#   Phoenix locally:  pip install arize-phoenix && phoenix serve
#                     OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentsys

# --- Phase 7C quality evals (optional, off) ---
# DeepEval is eval/test tooling, not runtime infrastructure. Leave disabled
# for normal app startup and deterministic Tier 1. Install requirements-eval.txt
# only in environments that run the optional quality tier.
DEEPEVAL_ENABLED=false
DEEPEVAL_JUDGE_MODEL=
DEEPEVAL_SAMPLE_COUNT=0
DEEPEVAL_DATASET_SUBSET=

# =====================================================================
# rag (hybrid retrieval + eval)
# =====================================================================
# Note: rag uses Chroma in EMBEDDED mode (a local directory), while agentsys
# talks to a Chroma SERVER over HTTP (CHROMA_HOST/PORT above). Same library,
# two different modes -- see docs/MERGE.md.
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_API_KEY=
